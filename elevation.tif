<!-- HTML for static distribution bundle build -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>OpenTopography API</title>
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:400,700|Source+Code+Pro:300,600|Titillium+Web:400,600,700" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="./swagger-ui.css" >
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/vnd.microsoft.icon" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.1/jquery.min.js"></script>
<!-- 
    <link rel="icon" type="image/png" href="./favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="./favicon-16x16.png" sizes="16x16" />
 -->
    <style>
      html
      {
        box-sizing: border-box;
        overflow: -moz-scrollbars-vertical;
        overflow-y: scroll;
      }

      *,
      *:before,
      *:after
      {
        box-sizing: inherit;
      }

      body
      {
        margin:0;
        background: #fafafa;
      }


.swagger-ui .topbar {
    /*padding: 8px 0;*/
    background-color: #2a68af;
}

.swagger-ui .topbar .download-url-wrapper .download-url-button {
    border-radius: 0;
    background: rgba(0,0,0,0.2)!important;
}
.swagger-ui .topbar .download-url-wrapper input[type=text] {
    background-color: #215999;
    color: #fff;
    border-radius: 0;
    border: none;
    outline: none;
}
.swagger-ui .info .title {
    height: 62px;
    padding-left: 90px;
    padding-top: 15px;
    background: url(/images/ot_transp_logo_2.png) no-repeat;
    cursor: pointer;
}
.swagger-ui .topbar a {
    display: none;
}

    </style>
  </head>

  <body>
    <div id="swagger-ui"></div>

    <script src="./swagger-ui-bundle.js"> </script>
    <script src="./swagger-ui-standalone-preset.js"> </script>
    <script>

    window.onload = function() {

        // Build a system
        const ui = SwaggerUIBundle({
            url: "/apidocs/openapi.json?sid=" + Math.random(),
            dom_id: '#swagger-ui',
            deepLinking: true,
            presets: [
                SwaggerUIBundle.presets.apis,
                SwaggerUIStandalonePreset
            ],
            plugins: [
                SwaggerUIBundle.plugins.DownloadUrl
            ],
            layout: "StandaloneLayout"
        })

        window.ui = ui;

        $(document).on('click', "[class^=title]", function(){
            window.location = "https://opentopography.org/";
        });
    }

  </script>
  </body>
</html>
